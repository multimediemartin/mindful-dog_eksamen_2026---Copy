---
import { createServerClient } from "../lib/supabase";
import { Image } from "astro:assets";

const supabase = createServerClient();
const { data, error } = await supabase.from("services").select(
  `
    *,
    traenere ( * )
  `,
);
---

<html lang="da">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Traenere</title>

  <body>
    <section>
      <ul>
        {
          data?.map((item) => {
            const t = item.traenere;
            return <li>{item.traenere?.fornavn}</li>;
          })
        }
      </ul>
      <ul style="display:flex; gap: 1rem; flex-wrap: wrap;">
        {
          data?.map((item) => (
            <li style="list-style: none;">
              <div>
                <Image
                  src={item.produkt_img}
                  alt={item.lokation}
                  style="
                width:
                300px;
                height:
                auto;"
                  inferSize={true}
                />
                <div>
                  <div>
                    <>
                      <>
                        <h6 style="font-size: 0.75rem; font-weight: 700; color: #333; font-family: Arial, Helvetica, sans-serif;">
                          {item.lokation}
                        </h6>
                        <h6 style="font-size: 0.75rem; font-weight: 700; color: #333; font-family: Arial, Helvetica, sans-serif;">
                          {item.type}
                        </h6>
                      </>
                      <h6 style="font-size: 0.75rem; font-weight: 700; color: #333; font-family: Arial, Helvetica, sans-serif;" />
                    </>
                  </div>
                  <h4 style="font-size: 1rem; font-weight: 800; color: #333; font-family: Arial, Helvetica, sans-serif;">
                    {item.hold}
                  </h4>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </body>
</html>
