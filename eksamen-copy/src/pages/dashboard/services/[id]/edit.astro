---
import { createServerClient } from "../../../../lib/supabaseClient";
import { Picture } from "astro:assets";

const supabase = createServerClient();
const { data } = await supabase.from("traenere").select(
  `
  (*),
    traenere ( * ),
    ikoner ( * )
  `,
);
---

<html lang="da">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Overblik</title>

  <body>
    <section>
      <div class="filter-box">
        <button class="hold-btn">HOLD</button>
        <button class="traenere-btn">TRÆNERE</button>
      </div>
      <div class="ul-box">
        <ul>
          {
            data?.map((item) => {
              const t = item;
              return (
                <div class="li-box">
                  <li class="inf-box">
                    <div class="box-1 leftie">
                      <h2>INFORMATION</h2>
                      <div class="dash-box">
                        <div class="flex-inf">
                          <div class="grid-inf">
                            <p>Fornavn:</p>
                            <span class="txt">
                              <p>{t?.fornavn}</p>
                            </span>
                          </div>
                          <div class="grid-inf">
                            <p>Efternavn:</p>
                            <span class="txt">
                              <p>{t?.efternavn}</p>
                            </span>
                          </div>
                        </div>
                      </div>
                      <div class="dash-box">
                        <div class="flex-inf">
                          <p>Lokation:</p>
                          <span class="txt">
                            <p>{t?.lokation}</p>
                          </span>
                        </div>
                        <div class="flex-inf">
                          <p>Adresse 1:</p>
                          <span class="txt">
                            <p>{t?.adresse_1}</p>
                          </span>
                        </div>
                        <div class="flex-inf">
                          <div class="grid-inf">
                            <p>Postnummer 1:</p>
                            <span class="txt">
                              <p>{t?.postnummer_1}</p>
                            </span>
                          </div>
                          <div class="grid-inf">
                            <p>Bynavn 1:</p>
                            <span class="txt">
                              <p>{t?.bynavn_1}</p>
                            </span>
                          </div>
                        </div>
                      </div>
                      <div class="dash-box">
                        <div class="flex-inf">
                          <p>Adresse 2:</p>
                          <span class="txt">
                            <p>{t?.adresse_2}</p>
                          </span>
                        </div>
                        <div class="flex-inf">
                          <div class="grid-inf">
                            <p>Postnummer 2:</p>
                            <span class="txt">
                              <p>{t?.postnummer_2}</p>
                            </span>
                          </div>
                          <div class="grid-inf">
                            <p>Bynavn 2:</p>
                            <span class="txt">
                              <p>{t?.bynavn_2}</p>
                            </span>
                          </div>
                        </div>
                      </div>
                      <div class="dash-box">
                        <div class="flex-inf">
                          <p>Mail:</p>
                          <span class="txt">
                            <p>{t?.traener_mail}</p>
                          </span>
                        </div>
                        <div class="flex-inf">
                          <p>Telefon:</p>
                          <span class="txt">
                            <p>{t?.traener_tlf}</p>
                          </span>
                        </div>
                      </div>
                      <div class="dash-box">
                        <div class="flex-inf">
                          <div class="grid-inf">
                            <p>
                              Fornavn
                              <br />
                              (Ekstra træner):
                            </p>
                            <span class="txt">
                              <p>{t?.fornavn_2}</p>
                            </span>
                          </div>
                          <div class="grid-inf">
                            <p>
                              Efternavn
                              <br />
                              (Ekstra træner):
                            </p>
                            <span class="txt">
                              <p>{t?.efternavn_2}</p>
                            </span>
                          </div>
                        </div>
                      </div>
                      <div class="box-1">
                        <h2>SLUG</h2>
                        <span class="txt">
                          <p>{t?.traener_slug}</p>
                        </span>
                      </div>
                    </div>
                  </li>
                  <div class="box-1">
                    <h2>PROFIL TEKST</h2>
                    <span class="txt">
                      <p>{t?.traener_info}</p>
                    </span>
                  </div>
                  <li>
                    <div class="box-1">
                      <h2>TESTIMONIALS</h2>
                      <span class="txt">
                        <p>{t?.testimonial_1}</p>
                      </span>
                      <span class="txt">
                        <p>{t?.testimonial_2}</p>
                      </span>
                      <span class="txt">
                        <p>{t?.testimonial_3}</p>
                      </span>
                    </div>
                  </li>
                  <button class="submit">OPDATER</button>
                </div>
              );
            })
          }
        </ul>
      </div>
    </section>
  </body>

  <style>
    section {
      padding: 4vh 4vw;
    }

    ul {
      display: grid;
      grid-template-columns: repeat(1fr 3fr);
      gap: 2.5rem;
      list-style: none;
      max-width: 80vw;
      margin: 0 auto;
    }

    p {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 0.875rem;
      color: #191618;
      margin: 0;
      line-height: 1.5;
    }

    h2 {
      color: #191618;
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 1.25rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .li-box {
      display: grid;
      grid-template-columns: 1fr 3fr;
      gap: 1.5rem;
      padding: 2rem 1rem;
      border-bottom: 1px solid #191618;
    }

    .box-1 {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .leftie {
      border-right: 1px solid #191618;
      padding-right: 1rem;
    }

    .txt {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 0.875rem;
      color: #191618;
      padding: 8px 12px;
      line-height: 1.5;
      display: flex;
      width: fit-content;
      height: fit-content;
      border: 1px solid #191618;
      border-radius: 4px;
      min-width: 14ch;
      min-height: 0.875rem;
    }

    .txt:empty {
      display: none;
      border: none;
    }

    .inf-box {
      grid-row: span 2;
    }
    .dash-box {
      display: grid;
      gap: 0.5rem;
      border: 1px dashed #191618;
      padding: 0.5rem;
      border-radius: 4px;
      padding: 8px;
      width: fit-content;
      min-width: 272px;
    }

    .flex-inf {
      display: flex;
      gap: 0.5rem;
      flex-wrap: nowrap;
      justify-content: space-between;
    }

    .grid-inf {
      display: grid;
      gap: 0.5rem;
    }

    .submit {
      padding: 1rem 2rem;
      background-color: #f7f7f7;
      color: #191618;
      border: 1px solid #191618;
      border-radius: 4px;
      cursor: pointer;
      font-size: 1rem;
      grid-column: span 2;
    }

    .submit:hover {
      border: 1px solid #a8a8a8;
      color: #a8a8a8;
    }

    .filter-box {
      display: flex;
      gap: 1rem;
      justify-content: center;
      margin-bottom: 1rem;
      border-bottom: 1px solid #191618;
      padding-bottom: 2rem;
    }

    .hold-btn,
    .traenere-btn {
      padding: 1rem 2rem;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 1rem;
      font-family: Arial, Helvetica, sans-serif;
      font-weight: 600;
      letter-spacing: 0.2rem;
      width: 16vw;
    }

    .hold-btn {
      background-color: #9dbbdf;
      color: #f7f7f7;
    }

    .hold-btn:hover {
      background-color: #788eaa;
      color: #f7f7f7;
    }

    .traenere-btn {
      background-color: #79772c;
      color: #f7f7f7;
    }

    .traenere-btn:hover {
      background-color: #403e00;
      color: #f7f7f7;
    }
  </style>
</html>
