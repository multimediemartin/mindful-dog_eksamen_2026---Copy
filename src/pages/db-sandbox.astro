---
import { createServerClient } from "../lib/supabase";
const supabase = createServerClient();
const { data: traenere } = await supabase.from("traenere").select();
---

<html>
  <head>
    <title>Traenere</title>
  </head>
  <body>
    <ul>
      {traenere?.map((traener) => <li>{traener.fornavn_1}</li>)}
    </ul>
  </body>
</html>
