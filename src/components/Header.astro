---
import Logo from "../assets/icon/logoSnude.svg";
import SearchButton from "../components/Buttons__&_links/SearchButton.astro";
import ThemeButton from "../components/Buttons__&_links/Themebutton.astro";
---

<header class="border-b-2 border-(--accent-300) bg-(--neutral-100)">
  <nav
    class="m-auto mt-0 flex w-[95cqw] items-center gap-4 px-4 py-4 text-center font-sans font-semibold md:grid md:grid-cols-[auto_minmax(0,1fr)_auto] md:items-center md:gap-x-8 md:gap-y-4"
  >
    <a href="/" class="h-auto w-fit"><Logo class="aspect-square h-18 w-18" /></a
    >
    <ul
      class="menu first [&_li]:lg:text-text-size-20 [&_li]:text-text-size-16 [&_li]:md:text-text-size-18 [&_li]:xl:text-text-size-25 hidden list-none gap-8 md:flex md:justify-center md:gap-8 md:justify-self-center [&_li]:relative [&_li]:my-4 [&_li]:block [&_li]:text-(--neutral-500) [&_li]:no-underline [&_li]:transition-colors [&_li]:duration-150 [&_li]:hover:text-(--accent-200) [&_li]:md:mx-auto [&_li]:lg:my-0"
    >
      <li>
        <a href="/">FORSIDE</a>
      </li>
      <li>
        <a href="/Hold_oversigt">HOLD OVERSIGT</a>
      </li>
      <li>
        <a href="/Om_os">OM OS</a>
      </li>
      <li>
        <a href="/Kontakt">KONTAKT</a>
      </li>
      <li>
        <a
          href="/Bliv_instruktoer"
          class="rounded-md bg-(--neutral-500) px-2 py-1 text-2xl whitespace-nowrap text-(--neutral-200) no-underline transition-colors duration-150 hover:bg-(--accent-200) md:text-base lg:text-xl"
          >BLIV INSTRUKTØR</a
        >
      </li>
    </ul>
    <div
      class="menu second hidden md:flex md:items-center md:gap-6 md:justify-self-end md:whitespace-nowrap"
    >
      <div class="inline-flex items-center gap-4">
        <ThemeButton />
        <SearchButton
          size="sm"
          closedIconClass="text-(--neutral-500)"
          closedIconHoverClass="group-hover:text-(--main-500)"
          openIconClass="text-(--neutral-100)"
          openIconHoverClass="group-hover:text-(--neutral-200)"
        />
      </div>
    </div>
    <!-- ny kode slut -->
    <span class="menu mbg md:hidden"></span>
    <span class="menu mline md:hidden"></span>
    <div
      id="burger"
      class="rounded-5 relative z-10 ml-auto h-10 w-10 shrink-0 cursor-pointer md:hidden [&_span]:relative [&_span]:my-1.5 [&_span]:block [&_span]:h-1.5 [&_span]:w-full [&_span]:rounded-sm [&_span]:bg-(--neutral-500)"
    >
      <span></span>
      <span></span>
      <span></span>
    </div>
  </nav>
</header>

<style>
  span {
    transition:
      transform 0.5s cubic-bezier(0.77, 0.2, 0.05, 1),
      opacity 0.55s ease;
  }

  nav > #burger.active span:nth-child(1) {
    transform: rotate(45deg) translate(0, -2px);
  }

  nav > #burger span:nth-child(1) {
    transform-origin: 0% 0%;
  }
  nav > #burger.active span:nth-child(2) {
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  nav > #burger span:nth-child(2) {
    opacity: 1;
    transition: opacity 0.55s ease-in;
  }

  nav > #burger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(0, 2px);
  }
  nav > #burger span:nth-child(3) {
    transform-origin: 0% 100%;
  }

  nav.active .menu.first {
    display: block;
    position: absolute;
    /* background-color: var(--neutral-100); */
    top: calc(var(--spacing) * 21);
    right: 0;
    width: 100%;
    z-index: 10;
    text-align: right;
    padding-right: calc(var(--spacing) * 4);
  }

  nav.active .menu.second {
    display: block;
    position: absolute;
    /* background-color: var(--neutral-100); */
    top: calc(var(--spacing) * 80);
    right: 0;
    width: 100%;
    z-index: 10;
    text-align: right;
    padding-right: calc(var(--spacing) * 4);
  }

  nav.active .menu.mbg {
    display: block;
    position: absolute;
    background-color: var(--neutral-100);
    width: 100%;
    height: 18rem;
    top: calc(var(--spacing) * 21);
    right: 0;
    width: 100%;
    z-index: 1;
    border-top: 2px solid var(--accent-300);
    /* border-bottom: 2px solid var(--accent-300); */
  }
  nav.active .menu.mline {
    display: block;
    position: absolute;
    background-color: var(--accent-300);
    width: 100%;
    height: calc(var(--spacing) * 0.5);
    top: calc(var(--spacing) * 74);
    right: 0;
    width: 100%;
    z-index: 10;
  }
</style>

<script src="../assets/js/burger.js"></script>
