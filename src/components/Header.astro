---
import Logo from "../assets/icon/logoSnude.svg";
import SearchButton from "../components/Buttons__&_links/SearchButton.astro";
import ThemeButton from "../components/Buttons__&_links/Themebutton.astro";
---

<nav class="relative border-b-2 border-(--accent-300) bg-(--neutral-100)">
  <div
    class="m-auto flex w-[95cqw] items-center justify-between gap-4 p-4 font-sans font-semibold"
  >
    <!-- Logo -->
    <a href="/" class="h-auto w-fit shrink-0">
      <Logo class="aspect-square h-18 w-18" />
    </a>

    <!-- Desktop nav links -->
    <ul
      class="menu first [&_li]:text-text-size-16 [&_li]:md:text-text-size-18 [&_li]:lg:text-text-size-20 hidden list-none gap-5 md:flex md:flex-1 md:items-center md:justify-center lg:gap-12 [&_li]:relative [&_li]:my-4 [&_li]:block [&_li]:text-(--neutral-500) [&_li]:no-underline [&_li]:transition-colors [&_li]:duration-150 [&_li]:hover:text-(--accent-200) [&_li]:lg:my-0"
    >
      <li><a href="/">FORSIDE</a></li>
      <li><a href="/Hold_oversigt">HOLD OVERSIGT</a></li>
      <li><a href="/Om_os">OM OS</a></li>
      <li><a href="/Kontakt">KONTAKT</a></li>
      <li>
        <a
          href="/Bliv_instruktoer"
          class="rounded-md bg-(--neutral-500) px-2 py-1 text-base whitespace-nowrap text-(--neutral-200) no-underline transition-colors duration-150 hover:bg-(--accent-200) lg:text-xl"
        >
          BLIV INSTRUKTØR
        </a>
      </li>
    </ul>

    <!-- Desktop right side -->
    <div class="hidden md:flex md:shrink-0 md:items-center md:gap-4">
      <div class="inline-flex items-center gap-4">
        <ThemeButton />
        <SearchButton
          size="sm"
          closedIconClass="text-(--neutral-500)"
          closedIconHoverClass="group-hover:text-(--main-500)"
          openIconClass="text-(--neutral-100)"
          openIconHoverClass="group-hover:text-(--neutral-200)"
        />
      </div>
    </div>

    <!-- Mobile right side -->
    <div class="flex items-center gap-2 md:hidden">
      <div id="mobile-search-wrap" class="relative">
        <SearchButton
          size="sm"
          closedIconClass="text-(--neutral-500)"
          closedIconHoverClass="group-hover:text-(--main-500)"
          openIconClass="text-(--neutral-100)"
          openIconHoverClass="group-hover:text-(--neutral-200)"
        />
      </div>

      <div
        id="burger"
        class="relative z-10 w-10 shrink-0 cursor-pointer rounded-sm [&_span]:relative [&_span]:my-1.5 [&_span]:block [&_span]:h-1.5 [&_span]:w-full [&_span]:rounded-sm [&_span]:bg-(--neutral-500)"
      >
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </div>

  <!-- Mobile menu backdrop -->
  <span class="menu mbg md:hidden"></span>

  <!-- Mobile menu divider line -->
  <span class="menu mline md:hidden"></span>
</nav>

<style>
  span {
    transition:
      transform 0.5s cubic-bezier(0.77, 0.2, 0.05, 1),
      opacity 0.55s ease;
  }

  nav > #burger {
    display: none;
  }

  @media (max-width: 47.9375rem) {
    nav > div > div > #burger {
      display: block;
    }

    #mobile-search-wrap form {
      position: absolute;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
      width: calc(100% - 5rem);
      z-index: 20;
    }

    nav.active .menu.first {
      display: block;
      position: absolute;
      top: calc(var(--spacing) * 21);
      right: 0;
      width: 100%;
      z-index: 10;
      text-align: right;
      padding-right: calc(var(--spacing) * 4);
    }

    nav.active .menu.first li {
      margin: 0.85rem 0;
    }

    nav.active .menu.first li:last-child {
      margin-bottom: 0.5rem;
    }
  }

  nav.active #burger span:nth-child(1) {
    transform: rotate(45deg) translate(0, -2px);
    transform-origin: 0% 0%;
  }

  nav.active #burger span:nth-child(2) {
    opacity: 0;
  }

  nav.active #burger span:nth-child(3) {
    transform: rotate(-45deg) translate(0, 2px);
    transform-origin: 0% 100%;
  }

  nav.active .menu.mbg {
    display: block;
    position: absolute;
    background-color: var(--neutral-100);
    width: 100%;
    min-height: 18rem;
    top: calc(var(--spacing) * 21);
    right: 0;
    z-index: 1;
    border-top: 2px solid var(--accent-300);
  }

  nav.active .menu.mline {
    display: block;
    position: absolute;
    background-color: var(--accent-300);
    width: 100%;
    height: calc(var(--spacing) * 0.5);
    top: calc(var(--spacing) * 90);
    right: 0;
    z-index: 10;
  }
</style>

<script src="../assets/js/burger.js"></script>
