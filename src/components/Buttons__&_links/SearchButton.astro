---
/* =========================================================
   SØGEKNAP
   Små størrelser åbner et søgefelt, store størrelser vises åbent.
   ========================================================= */
import SearchIcon from "../../assets/icon/Searchicon.svg?raw";
type Size = "sm" | "lg";

interface Props {
  size?: Size;
  placeholder?: string;
  label?: string;
  stylingclasses?: string;
  closedIconClass?: string;
  closedIconHoverClass?: string;
  openIconClass?: string;
  openIconHoverClass?: string;
}

const {
  size = "sm",
  placeholder = "Søg her…",
  label = "Søg",
  stylingclasses = "",
  closedIconClass = "text-(--neutral-500)",
  closedIconHoverClass = "group-hover:text-(--main-400)",
  openIconClass = "text-(--neutral-100)",
  openIconHoverClass = "group-hover:text-(--main-100)",
} = Astro.props as Props;

const isCollapsible = size === "sm";

const iconMarkup = SearchIcon.replace("<svg ", '<svg class="h-full w-full" ');

/* =========================================================
   BASE STYLES
   ========================================================= */

const base = {
  // Wrapper omkring hele søgekomponenten.
  wrapper: "relative inline-flex shrink-0",
  // Selve søgefeltets ydre skal i åben tilstand. Fjernet kant og fokus-stilarter;
  // kant beholdes kun på den lukkede `sm`-knap via `colors.closed`.
  shell:
    "inline-flex items-stretch overflow-hidden bg-(--neutral-0) shadow-xs transition-all",
  // Fælles input-styling til begge versioner.
  input:
    "min-w-0 flex-1 appearance-none border-0 bg-transparent font-sans outline-none shadow-none focus:ring-0",
  // Fælles knap-styling til både lukket og åben tilstand.
  button:
    "group shrink-0 inline-flex items-center justify-center font-sans font-semibold cursor-pointer transition-colors",
  // Ikon som bruges i begge tilstande.
  icon: "shrink-0",
};

/* =========================================================
   COLORS
   ========================================================= */

const colors = {
  // Tekstfarve i knapper og input.
  text: "text-(--neutral-500)",
  // Placeholder-farve i inputfeltet.
  placeholder: "placeholder:text-(--neutral-300)",
  // Primær baggrund og hover-farve til søgeknappen.
  primary: "bg-(--main-400) hover:bg-(--main-500) text-white",
  // Lukket knap bruger neutral baggrund og kant.
  closed: "bg-(--neutral-0) text-(--neutral-500) border border-(--neutral-300)",
};

/* =========================================================
   SIZE SYSTEM
   ========================================================= */

const sizeStyles = {
  sm: {
    // Ydre luft omkring søgefeltet i sm.
    shell: " rounded-[var(--primitive-radius-lg)]",
    // Tekststørrelse i sm.
    text: "text-size-14",
    // Padding i den lukkede knap i sm.
    closedPadding: "p-[var(--primitive-space-8)]",
    // Padding i inputfeltet i sm.
    inputPadding:
      "px-[var(--primitive-space-16)] py-[var(--primitive-space-8)]",
    // Vandret padding i submit-knappen i sm.
    buttonPadding: "px-[var(--primitive-space-12)]",
    // Ikonstørrelse i sm.
    icon: "size-8",
    // Afstand mellem ikon og tekst i knappen.
    gap: "gap-1.5",
  },
  lg: {
    // Ydre luft omkring søgefeltet i lg.
    shell: " rounded-[var(--primitive-radius-md)]",
    // Tekststørrelse i lg.
    text: "text-size-17",
    // Padding i den lukkede knap i lg.
    closedPadding: "p-[var(--primitive-space-12)]",
    // Padding i inputfeltet i lg.
    inputPadding:
      "px-[var(--primitive-space-16)] py-[var(--primitive-space-12)]",
    // Vandret padding i submit-knappen i lg.
    buttonPadding: "px-[var(--primitive-space-16)]",
    // Ikonstørrelse i lg.
    icon: "size-8",
    // Afstand mellem ikon og tekst i knappen.
    gap: "gap-2",
  },
}[size];

const closedIconClasses = [
  base.icon,
  sizeStyles.icon,
  closedIconClass,
  closedIconHoverClass,
]
  .filter(Boolean)
  .join(" ");

const openIconClasses = [
  base.icon,
  sizeStyles.icon,
  openIconClass,
  openIconHoverClass,
]
  .filter(Boolean)
  .join(" ");
---

{
  isCollapsible ? (
    <div
      x-ref="searchRoot"
      x-data="{ open: false, query: '' }"
      x-on:keydown.escape.window="open = false"
      x-on:click.window="if (open && !$refs.searchRoot.contains($event.target)) open = false"
      class:list={[base.wrapper, stylingclasses]}
    >
      <button
        x-on:click="open = true; $nextTick(() => $refs.input.focus())"
        type="button"
        aria-label="Åbn søgefelt"
        class:list={[
          base.button,
          colors.closed,
          sizeStyles.closedPadding,
          "rounded-full",
          sizeStyles.text,
          "transition-opacity duration-150",
        ]}
        x-bind:class="open ? 'opacity-0 pointer-events-none' : 'opacity-100'"
      >
        <span
          aria-hidden="true"
          class={closedIconClasses}
          set:html={iconMarkup}
        />
      </button>

      <form
        x-show="open"
        x-transition
        x-on:submit.prevent="$dispatch('search', { query })"
        style="display:none;"
        class:list={[
          base.shell,
          sizeStyles.shell,
          sizeStyles.text,
          "w-full max-w-full min-w-0 shadow-md",
        ]}
      >
        <input
          x-ref="input"
          x-model="query"
          type="search"
          placeholder={placeholder}
          class:list={[
            base.input,
            colors.text,
            colors.placeholder,
            sizeStyles.inputPadding,
          ]}
        />

        <button
          type="submit"
          class:list={[
            base.button,
            colors.primary,
            sizeStyles.buttonPadding,
            sizeStyles.gap,
            "self-stretch",
          ]}
        >
          <span
            aria-hidden="true"
            class={openIconClasses}
            set:html={iconMarkup}
          />
          {label}
        </button>
      </form>
    </div>
  ) : (
    <form
      x-data="{ query: '' }"
      x-on:submit.prevent="$dispatch('search', { query })"
      class:list={[
        base.shell,
        sizeStyles.shell,
        sizeStyles.text,
        stylingclasses,
      ]}
    >
      <input
        x-model="query"
        type="search"
        placeholder={placeholder}
        class:list={[
          base.input,
          colors.text,
          colors.placeholder,
          sizeStyles.inputPadding,
        ]}
      />

      <button
        type="submit"
        class:list={[
          base.button,
          colors.primary,
          sizeStyles.buttonPadding,
          sizeStyles.gap,
          "self-stretch",
        ]}
      >
        <span
          aria-hidden="true"
          class={openIconClasses}
          set:html={iconMarkup}
        />
        {label}
      </button>
    </form>
  )
}
