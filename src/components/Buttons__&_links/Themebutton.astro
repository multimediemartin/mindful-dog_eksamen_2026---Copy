---
/* =========================================================
	 TEMA-KNAP
	 Skifter mellem standard og dark ved at ændre data-theme på html.
	 ========================================================= */

type ThemeButtonSize = "sm" | "md" | "lg" | "xl";

interface Props {
  size?: ThemeButtonSize;
  label?: string;
  darkLabel?: string;
  lightLabel?: string;
  stylingclasses?: string;
}

const {
  size = "md",
  label = "Skift tema",
  darkLabel = "Mørkt tema",
  lightLabel = "Lyst tema",
  stylingclasses = "duration-200 hover:scale-[1.01]",
} = Astro.props as Props;

// Størrelsesvarianter, så knappen følger samme mønster som de andre knapper.
const sizeClasses = {
  sm: "h-[35px] px-4 text-size-14 rounded-sm gap-2",
  md: "h-[44px] px-5 text-size-15 rounded-md gap-2",
  lg: "h-[53px] px-6 text-size-17 rounded-md gap-3",
  xl: "h-[81px] px-8 text-size-30 rounded-md gap-3",
};

// Fælles knap-klasse bygget på de eksisterende tema-tokens.
const buttonClass = [
  "inline-flex items-center justify-center font-sans font-semibold leading-none transition-colors duration-150 hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-(--main-400) focus-visible:ring-offset-2 cursor-pointer bg-(--button-primary-bg) text-(--button-primary-text) hover:bg-(--button-primary-bg-hover)",
  sizeClasses[size],
  stylingclasses,
]
  .filter(Boolean)
  .join(" ");
---

<button
  type="button"
  x-data={`{
		// Gemmer aktuel tema i både Alpine state og localStorage.
		theme: localStorage.getItem('theme') || document.documentElement.dataset.theme || 'standard',
		init() {
			this.applyTheme(this.theme);
		},
		// Sætter temaet på html-elementet, så CSS kan skifte efter data-theme.
		applyTheme(theme) {
			this.theme = theme;
			document.documentElement.dataset.theme = theme;
			localStorage.setItem('theme', theme);
		},
		// vælger mellem lys og mørk tilstand.
		toggle() {
			this.applyTheme(this.theme === 'dark' ? 'standard' : 'dark');
		}
	}`}
  x-init="init()"
  @click="toggle()"
  class={buttonClass}
>
  <!-- Teksten skifter afhængigt af det aktive tema. -->
  <span x-text="theme === 'dark' ? lightLabel : darkLabel"></span>
  <span class="sr-only">{label}</span>
</button>
