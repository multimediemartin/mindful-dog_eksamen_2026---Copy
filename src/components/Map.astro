---
import Heading from "./Heading.astro";
import Text from "./Text.astro";
import LocationButton from "./Buttons__&_links/LocationButton.astro";
import LinkButton from "./Buttons__&_links/LinkButton.astro";

// ServiceItem svarer til ét hold eller én træner fra Supabase
interface ServiceItem {
  // lokation er det geografiske område, f.eks. "Vestsjælland"
  // spørgsmålstegn betyder at feltet godt må mangle
  lokation?: string;
  // hold er navnet på holdet
  hold?: string;
  // slug er en URL-venlig version af navnet
  slug?: string;

  // traener er et objekt med trænerens oplysninger
  // spørgsmålstegnet efter traener betyder at hele objektet kan mangle
  traener?: {
    fornavn?: string;
    efternavn?: string;
    slug?: string;
    traener_slug?: string;
    adresse_1?: string;
    postnummer_1?: string;
    bynavn_1?: string;
    adresse_2?: string;
    postnummer_2?: string;
    bynavn_2?: string;
    // fornavn_2 og efternavn_2 bruges hvis der er to trænere
    fornavn_2?: string;
    efternavn_2?: string;
  };

  // traenere kan være ét objekt, en liste af objekter eller ingenting
  // den lodrette streg betyder "eller"
  // de firkantede klammer betyder en liste
  // null betyder helt tomt
  traenere?: ServiceItem["traener"] | ServiceItem["traener"][] | null;
}

// Koordinater – et GPS-punkt
interface Koordinater {
  // lat er breddegraden (nord/syd)
  lat: number;
  // lng er længdegraden (øst/vest)
  lng: number;
}

// KortLokation er den færdige lokation der bliver sendt ned i browseren (til Alpine.js)
interface KortLokation {
  // id er en entydig nøgle vi laver ud fra adressen
  id: string;
  // label er det navn der vises på kortet
  label: string;
  // adresse er den samlede adresse som tekst
  adresse: string;
  // lat er breddegraden
  lat: number;
  // lng er længdegraden
  lng: number;
  // byer er en liste med bynavne
  byer: string[];
  // hold er en liste af objekter med en titel og et link
  hold: { titel: string; href: string }[];
  // traenere er en liste af objekter med et navn og et link
  traenere: { navn: string; href: string }[];
}

// LokationsAkkumulator er en midlertidig opsamling mens vi gennemgår data
interface LokationsAkkumulator {
  // id er et entydigt id
  id: string;
  // label er visningsnavnet
  label: string;
  // adresse er den fulde adressetekst
  adresse: string;
  // søgeTekst er den tekst vi sender til Nominatim (adresse plus ", Danmark")
  søgeTekst: string;
  // byerArr er en liste med bynavne, for at undgå dobbelte
  byerArr: string[];
  // holdObj er et opslag: holdnavn peger på holdets URL
  holdObj: Record<string, string>;
  // traenereObj er et opslag: trænernavn peger på trænerprofilens URL
  traenereObj: Record<string, string>;
}

// Props er de værdier der kan sendes ind i komponenten udefra
interface Props {
  // eyebrow er en lille tekst over overskriften
  eyebrow?: string;
  // title er sektionens overskrift
  title?: string;
  // services er dataen fra Supabase (en liste af ServiceItem)
  services?: ServiceItem[];
  // bgClass er en Tailwind-klasse til baggrundsfarve
  bgClass?: string;
}

// Astro: her modtager vi props og sætter standardværdier
// de krøllede klammer pakker objektet ud
// lighedstegnet giver en standard hvis prop mangler
const {
  eyebrow = "Lokationer",
  title = "Find en træner nær dig",
  services = [],
  bgClass = "bg-(--neutral-0)",
} = Astro.props;

// ==================================================================
// TypeScript — små hjælpefunktioner
// ==================================================================

// lagId laver et URL- og JavaScript-venligt id ud fra en tekst
// den gør bogstaver små, fjerner mellemrum, skiller æøå ad og fjerner accenter
// erstatter alt der ikke er a-z eller 0-9 med bindestreg
// fjerner bindestreger i start og slut, og hvis resultatet er tomt bruger den "ukendt"
function lagId(vaerdi: string): string {
  return (
    vaerdi
      .toLowerCase()
      .trim()
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "") || "ukendt"
  );
}

// formatAdresse bygger en adresselinje: "Gade, Postnummer By"
// spørgsmålstegnet efter parameternavnet betyder at parameteren er valgfri
// ?. betyder at vi kun kalder trim hvis feltet findes
// ?? betyder at hvis det er tomt eller undefined, brug det der står efter
// .filter(Boolean) smider tomme og undefined ud af listen
// .join(" ") sætter delene sammen med mellemrum
function formatAdresse(gade?: string, postnr?: string, by?: string): string {
  const byDel = [postnr?.trim(), by?.trim()].filter(Boolean).join(" ");
  return [gade?.trim(), byDel].filter(Boolean).join(", ").trim();
}

// decodeHtml laver HTML-koder om til almindelige tegn
// f.eks. &amp; bliver til &
function decodeHtml(tekst: string): string {
  return tekst
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");
}

// erVirtuelLokation tjekker om teksten er "pr. aftale" eller lignende
// vi normaliserer først (små bogstaver, fjerner æøå) og sammenligner så
function erVirtuelLokation(tekst: string): boolean {
  const normaliseret = tekst
    .toLowerCase()
    .trim()
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "");
  return (
    normaliseret === "pr. aftale" ||
    normaliseret === "pr aftale" ||
    normaliseret === "efter aftale"
  );
}

// hentTraener finder trænerobjektet i et service, uanset om det er gemt på den ene eller anden måde
// typeof tjekker om det er et objekt, Array.isArray tjekker om det er en liste
// hvis det er en liste tager vi det første element (nummer 0)
function hentTraener(
  service: ServiceItem,
): NonNullable<ServiceItem["traener"]> | null {
  // tilfælde 1: traener findes og er et objekt
  if (service.traener && typeof service.traener === "object") {
    return service.traener;
  }
  // tilfælde 2: traenere er en liste
  if (service.traenere && Array.isArray(service.traenere)) {
    const første = service.traenere[0];
    // spørgsmålstegn og kolon betyder "hvis sandt returner dette, ellers det andet"
    return første && typeof første === "object" ? første : null;
  }
  // tilfælde 3: traenere er ét enkelt objekt
  if (service.traenere && typeof service.traenere === "object") {
    return service.traenere;
  }
  return null;
}

// hentTraenerNavn sætter fornavn og efternavn sammen til ét visningsnavn
// hvis der er to trænere, f.eks. mor og datter, bliver det "Mor & Datter"
function hentTraenerNavn(
  t: NonNullable<ServiceItem["traener"]> | null,
): string {
  // hvis t er tomt, stop og giv tom tekst tilbage
  if (!t) return "";
  // byg det første navn
  const navn1 = [t.fornavn?.trim() ?? "", t.efternavn?.trim() ?? ""]
    .filter(Boolean)
    .join(" ");
  // byg det andet navn (hvis det findes)
  const navn2 = [t.fornavn_2?.trim() ?? "", t.efternavn_2?.trim() ?? ""]
    .filter(Boolean)
    .join(" ");
  // hvis begge findes, sæt dem sammen med &
  if (navn1 && navn2) return `${navn1} & ${navn2}`;
  // ellers returner det af de to der findes
  return navn1 || navn2;
}

// ==================================================================
// Nominatim / OpenStreetMap — adresse omregnet til koordinater
// ==================================================================
// Nominatim er en gratis tjeneste fra OpenStreetMap. Vi installerer ingenting,
// vi sender bare en helt almindelig internet-forespørgsel.
// Regler: max et kald i sekundet, man skal sende et User-Agent, man skal huske
// at cache resultater, og man skal kreditere OpenStreetMap på siden.

// HARDCODE: nogle få adresser som Nominatim ikke kender, får koordinater manuelt
// nøglen er et stykke af adressen, værdien er {lat, lng}
const HARDCODE: Record<string, Koordinater> = {
  løvbakke: { lat: 56.17859336611557, lng: 8.948975835171785 },
  loevbakke: { lat: 56.17859336611557, lng: 8.948975835171785 },
};

// FALLBACK: hvis Nominatim slet ingenting finder, har vi cirka-koordinater for regioner
const FALLBACK: Record<string, Koordinater> = {
  svendborg: { lat: 55.0598, lng: 10.6087 },
  vestsjælland: { lat: 55.4038, lng: 11.3544 },
  ikast: { lat: 56.1393, lng: 9.1578 },
  vejen: { lat: 55.479, lng: 9.1363 },
  sydjylland: { lat: 55.4913, lng: 9.4721 },
  skærbæk: { lat: 55.1566, lng: 8.7669 },
  sønderjylland: { lat: 55.0439, lng: 9.4169 },
  als: { lat: 54.9134, lng: 9.8516 },
};

// geocodeCache: vi husker resultater, så vi ikke spørger Nominatim om det samme to gange
// Vi gemmer et Promise (et løfte om et svar) for at undgå at sende to samtidige kald
const geocodeCache: Record<string, Promise<Koordinater | null>> = {};

// geocodAdresse: den funktion der rent faktisk spørger Nominatim
// async betyder at den kan vente undervejs, og den returnerer et Promise
// fetch er den funktion der sender en internet-forespørgsel
// Number() laver tekst om til tal, fordi Nominatim svarer med tekst
async function geocodAdresse(søgeTekst: string): Promise<Koordinater | null> {
  // laver teksten til små bogstaver, så vi kan matche løvbakke/Løvbakke
  const søgeLower = søgeTekst.toLowerCase();

  // tjek først om adressen er en af de hardcodede
  for (const nøgle of Object.keys(HARDCODE)) {
    if (søgeLower.includes(nøgle)) {
      return HARDCODE[nøgle];
    }
  }

  // hvis adressen ikke allerede er i cachen, så spørg Nominatim
  if (!geocodeCache[søgeTekst]) {
    // her bygger vi adressen til Nominatim
    const url = `https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=dk&q=${encodeURIComponent(søgeTekst)}`;

    // gem fetch-kaldet i cachen (det er et Promise)
    geocodeCache[søgeTekst] = fetch(url, {
      headers: {
        Accept: "application/json",
        "Accept-Language": "da",
        // User-Agent: Nominatim kræver at man fortæller hvem man er
        "User-Agent": "mindful-dog-eksamen/1.0",
      },
    })
      .then((res) => (res.ok ? res.json() : []))
      .then((data: { lat?: string; lon?: string }[]) => {
        const første = Array.isArray(data) ? data[0] : null;
        if (!første?.lat || !første?.lon) return null;
        // Number() laver teksten "55.47" om til tallet 55.47
        return { lat: Number(første.lat), lng: Number(første.lon) };
      })
      .catch(() => null);
  }

  // returner det cachede resultat (vi ved at det findes nu)
  return geocodeCache[søgeTekst]!;
}

// getFallback: hvis geocodingen slet ikke lykkedes, finder vi cirka-koordinater for regionen
// de to spørgsmålstegn (??) betyder "prøv den næste, hvis den forrige er tom"
function getFallback(lokation: string): Koordinater {
  const nøgle = lokation
    .toLowerCase()
    .trim()
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "");

  return (
    FALLBACK[lokation.toLowerCase().trim()] ??
    FALLBACK[nøgle] ?? { lat: 56.0, lng: 10.5 } // allersidste udvej: midt i Danmark
  );
}
// SLUT Nominatim / OpenStreetMap

// ==================================================================
// TypeScript — samle alle lokationer fra vores data
// ==================================================================

// lokationsDict er en tom opslagstabel (dictionary), vi fylder op nu
const lokationsDict: Record<string, LokationsAkkumulator> = {};

// for..of løber igennem hver eneste service i services-listen
for (const service of services) {
  // holdTitel: hent holdets navn og fjern eventuelle HTML-koder
  const holdTitel = decodeHtml(service.hold?.trim() ?? "");
  // holdHref: link til holdsiden, kun hvis der er et slug
  const holdHref = service.slug ? `/Hold_side/${service.slug}` : "";

  // t: trænerobjektet (eller null)
  const t = hentTraener(service);
  // trainerNavn: det fulde trænernavn
  const trainerNavn = hentTraenerNavn(t);
  // trainerSlug: prøv først traener_slug, ellers slug, ellers tom streng
  const trainerSlug = t?.traener_slug?.trim() ?? t?.slug?.trim() ?? "";
  // trainerHref: link til trænerprofilen, kun hvis der er et slug
  const trainerHref = trainerSlug ? `/Instruktoer_profil/${trainerSlug}` : "";

  // lokNavn: lokationens navn (f.eks. "Vestsjælland")
  const lokNavn = service.lokation?.trim() ?? "";

  // spring over, hvis det er en virtuel lokation ("pr. aftale")
  if (erVirtuelLokation(lokNavn)) continue;

  // en midlertidig type til ét adressepunkt
  type AdresseEntry = { adresse: string; by: string; label: string };
  const entries: AdresseEntry[] = [];

  // primær adresse
  const adr1 = formatAdresse(t?.adresse_1, t?.postnummer_1, t?.bynavn_1);
  if (adr1) {
    entries.push({
      adresse: adr1,
      by: t?.bynavn_1?.trim() ?? "",
      label: t?.bynavn_1?.trim() || lokNavn || adr1,
    });
  }

  // sekundær adresse (hvis træneren har to træningssteder)
  const adr2 = formatAdresse(t?.adresse_2, t?.postnummer_2, t?.bynavn_2);
  if (adr2) {
    entries.push({
      adresse: adr2,
      by: t?.bynavn_2?.trim() ?? "",
      label: t?.bynavn_2?.trim() || lokNavn || adr2,
    });
  }

  // hvis der slet ingen adresser var, men vi har et lokationsnavn, så brug det
  if (entries.length === 0 && lokNavn) {
    entries.push({ adresse: lokNavn, by: lokNavn, label: lokNavn });
  }

  // gå igennem alle adressepunkterne og læg dem ind i lokationsDict
  for (const entry of entries) {
    // lav et unikt id ud fra adressen
    const id = lagId(entry.adresse);

    // hvis adressen ikke findes i forvejen, opret en ny post
    if (!lokationsDict[id]) {
      lokationsDict[id] = {
        id,
        label: entry.label,
        adresse: entry.adresse,
        // søgeTekst: det vi sender til Nominatim
        søgeTekst: `${entry.adresse}, Danmark`,
        byerArr: entry.by ? [entry.by] : [],
        holdObj: {},
        traenereObj: {},
      };
    }

    const lok = lokationsDict[id];

    // tilføj bynavn, hvis det ikke allerede er der
    if (entry.by && !lok.byerArr.includes(entry.by)) {
      lok.byerArr.push(entry.by);
    }
    // tilføj holdet (nøgle er titel, værdi er link)
    if (holdTitel && holdHref) {
      lok.holdObj[holdTitel] = holdHref;
    }
    // tilføj træneren (nøgle er navn, værdi er link)
    if (trainerNavn && trainerHref) {
      lok.traenereObj[trainerNavn] = trainerHref;
    }
  }
}

// ==================================================================
// Nominatim — hent koordinater til alle lokationer samtidigt
// ==================================================================

// Promise.all sender alle geocoding-kald af sted på én gang og venter på dem
// Object.values() giver en liste med alle værdierne fra objektet
const lokationer: KortLokation[] = await Promise.all(
  Object.values(lokationsDict).map(async (lok) => {
    // kald Nominatim (eller tag fra cache)
    const coords = await geocodAdresse(lok.søgeTekst);
    // hvis det fejlede, brug fallback-koordinaterne
    const endeligeKoords: Koordinater = coords ?? getFallback(lok.label);

    // byg det færdige KortLokation-objekt
    return {
      id: lok.id,
      label: lok.label,
      adresse: lok.adresse,
      lat: endeligeKoords.lat,
      lng: endeligeKoords.lng,
      byer: lok.byerArr,
      // Object.entries laver {a: b} om til [ [a, b] ]
      hold: Object.entries(lok.holdObj).map(([titel, href]) => ({
        titel,
        href,
      })),
      traenere: Object.entries(lok.traenereObj).map(([navn, href]) => ({
        navn,
        href,
      })),
    } satisfies KortLokation;
  }),
);

// startId: id på den allerførste lokation (eller tom streng, hvis listen er tom)
const startId = lokationer[0]?.id ?? "";
---

<!-- ==================================================================
     HTML — det som sendes til browseren (Astro, Alpine.js, Leaflet)
     ================================================================== --><!-- Leaflet: hent CSS-filen (fra et CDN, ingen installation) -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<!-- Astro + Alpine.js: hovedsektionen for kortet -->
<section
  class:list={[
    "px-(--page-space-inline) py-(--section-space-y) select-none",
    bgClass,
  ]}
  x-data={`kortKomponent(${JSON.stringify({ lokationer, startId })})`}
  x-init="init()"
>
  <!-- Astro: header med overskrift og eyebrow -->
  <div class="mb-8">
    <Text
      size="label_2"
      font="sans"
      weight="semibold"
      stylingclasses="mb-1 tracking-widest text-(--text-label) uppercase"
    >
      {eyebrow}
    </Text>
    <Heading
      htmlheading="h2"
      size="h4"
      font="display"
      weight="semibold"
      stylingclasses="text-(--text-primary)"
    >
      {title}
    </Heading>
  </div>

  <!-- Tailwind: layout med grid (mobil én kolonne, desktop fem/tre kolonner) -->
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-5 xl:grid-cols-3">
    <!-- Leaflet: kort-container og loading-spinner -->
    <div class="relative lg:col-span-3 xl:col-span-2">
      <!-- Alpine.js: x-ref giver en direkte reference til dette element (kortet tegnes her) -->
      <div
        x-ref="kortCanvas"
        class="1/1 h-[50vh] w-full overflow-hidden rounded-xl border border-(--neutral-200) shadow-sm lg:h-140"
        style="z-index: 0;"
      >
      </div>

      <!-- Alpine.js: spinneren vises så længe indlæser er true -->
      <div
        x-show="indlæser"
        class="absolute inset-0 flex items-center justify-center rounded-xl bg-(--neutral-100)/80"
      >
        <div
          class="h-8 w-8 animate-spin rounded-full border-4 border-(--main-200) border-t-(--main-400)"
        >
        </div>
      </div>
    </div>

    <!-- Astro + Alpine: listen over lokationer -->
    <div
      class="flex flex-col gap-2 overflow-y-auto rounded-xl border border-(--neutral-200) bg-(--neutral-0) p-3 shadow-sm lg:col-span-2 lg:max-h-140 xl:col-span-1"
    >
      <Text
        size="label_2"
        font="sans"
        weight="semibold"
        stylingclasses="px-2 pt-1 tracking-wider text-(--text-label) uppercase"
      >
        Vælg lokation
      </Text>

      <!-- Alpine.js: vises kun hvis der slet ingen lokationer er -->
      <template x-if="lokationer.length === 0">
        <Text
          size="p4"
          font="sans"
          weight="regular"
          stylingclasses="px-2 py-4 text-(--text-muted) italic"
        >
          Ingen lokationer fundet.
        </Text>
      </template>

      <!-- Astro: her genererer vi en knap for hver lokation (det sker på serveren) -->
      {
        lokationer.map((lok) => (
          <LocationButton
            size="lg"
            color="main"
            location={lok.label}
            address={lok.adresse}
            stylingclasses="w-full border border-transparent"
            x-on:click={`vælgLokation(${JSON.stringify(lok.id)})`}
            x-bind:class={`aktivId === ${JSON.stringify(lok.id)}
            ? 'border-(--main-300) bg-(--button-main-bg) text-(--button-main-text) shadow-sm'
            : 'bg-(--main-100) hover:bg-(--main-200)'`}
          />
        ))
      }
    </div>
  </div>

  <!-- Alpine.js: detalje-panelet under kortet -->
  <div
    x-show="aktivLokation && (aktivLokation.hold.length > 0 || aktivLokation.traenere.length > 0)"
    x-transition:enter="transition duration-300 ease-out"
    x-transition:enter-start="opacity-0 translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition duration-150 ease-in"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="mt-6 rounded-xl border border-(--neutral-200) bg-(--neutral-0) p-6 shadow-sm"
  >
    <Text
      size="label_2"
      font="sans"
      weight="semibold"
      stylingclasses="mb-4 tracking-wider text-(--text-label) uppercase"
    >
      Lokation, udbud og instruktører
    </Text>

    <!-- Alpine.js: viser den valgte lokations navn og adresse -->
    <div
      x-show="aktivLokation"
      class="mb-5 rounded-lg border-2 border-(--main-100) bg-(--neutral-100) p-4"
    >
      <Text
        size="label_2"
        font="sans"
        weight="semibold"
        stylingclasses="mb-1 text-(--text-label) uppercase tracking-widest"
      >
        Lokation >
      </Text>
      <Heading htmlheading="h3" size="h4" font="display" weight="bold">
        <!-- Alpine.js: x-text sætter teksten dynamisk -->
        <span x-text="aktivLokation?.label"></span>
      </Heading>
      <Text
        size="p3"
        font="sans"
        weight="regular"
        stylingclasses="mt-1 text-(--text-muted)"
      >
        <span x-text="aktivLokation?.adresse"></span>
      </Text>
    </div>

    <!-- Alpine.js: udbud – links til de enkelte hold -->
    <div x-show="aktivLokation?.hold?.length > 0" class="mb-5">
      <Text
        size="label_2"
        font="sans"
        4
        weight="regular"
        stylingclasses="mb-2 tracking-widest text-(--text-muted) uppercase"
      >
        Udbud
      </Text>
      <div class="flex flex-wrap gap-3">
        <!-- Alpine.js: x-for laver en knap for hvert hold -->
        <template x-for="hold in aktivLokation?.hold" x-bind:key="hold.href">
          <LinkButton
            size="sm"
            color="secondary"
            x-bind:href="hold.href"
            x-text="hold.titel"
          />
        </template>
      </div>
    </div>

    <!-- Alpine.js: instruktører – links til trænerprofiler -->
    <div x-show="aktivLokation?.traenere?.length > 0">
      <Text
        size="label_2"
        font="sans"
        weight="regular"
        stylingclasses="mb-2 tracking-widest text-(--text-muted) uppercase"
      >
        Instruktører
      </Text>
      <div class="flex flex-wrap gap-3">
        <template
          x-for="traener in aktivLokation?.traenere"
          x-bind:key="traener.href"
        >
          <LinkButton
            size="sm"
            color="main"
            x-bind:href="traener.href"
            x-text="traener.navn"
          />
        </template>
      </div>
    </div>
  </div>
</section>

<!-- Leaflet: indlæs JavaScript-biblioteket (fra CDN) -->
<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""></script>

<!-- Alpine.js: selve frameworket (defer = vent med at køre til HTML'en er færdig) -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
></script>

<!-- Alpine.js + Leaflet: den centrale logik for kortet -->
<script is:inline>
  // Alpine.js: kortKomponent er den funktion Alpine bruger til at styre kortet
  function kortKomponent(config) {
    return {
      // --- reaktive variabler (Alpine holder øje med dem og opdaterer HTML automatisk) ---
      // lokationer: alle lokationer fra serveren
      lokationer: config.lokationer,
      // aktivId: id'et på den lokation brugeren har valgt
      aktivId: config.startId,
      // indlæser: styrer om spinneren skal vises
      indlæser: true,
      // kortInstans: her gemmer vi selve Leaflet-kortet
      kortInstans: null,
      // markørMap: et opslag så vi kan finde markører ud fra id
      markørMap: {},

      // Alpine.js: get aktivLokation – en beregnet værdi der altid finder det aktuelle lokationsobjekt
      get aktivLokation() {
        return this.lokationer.find((l) => l.id === this.aktivId) ?? null;
      },

      // Alpine.js: init – bliver kaldt automatisk når Alpine-komponenten starter
      init() {
        // $nextTick venter til DOM'en er helt klar
        this.$nextTick(() => {
          this.opsætKort();
          this.indlæser = false; // skjul spinneren
        });
      },

      // Leaflet: opsætKort – her bygger vi hele Leaflet-kortet
      opsætKort() {
        // stop hvis Leaflet ikke er indlæst endnu
        if (!window.L) return;

        // L.map opretter kortet i vores div (som vi har refereret med x-ref)
        this.kortInstans = window.L.map(this.$refs.kortCanvas, {
          zoomControl: true,
          scrollWheelZoom: false,
          attributionControl: false,
        });

        // L.tileLayer tilføjer selve kortbillederne (fliserne)
        // fliserne kommer fra CartoCDN, men data er OpenStreetMap
        window.L.tileLayer(
          "https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png",
          { maxZoom: 19 },
        ).addTo(this.kortInstans);

        // for hver lokation laver vi en markør
        this.lokationer.forEach((lok) => {
          // L.marker: ny markør på koordinaterne
          const markør = window.L.marker([lok.lat, lok.lng], {
            // vores eget ikon – aktivt hvis det er den valgte lokation
            icon: this.lagIkon(lok.id === this.aktivId),
          }).addTo(this.kortInstans);

          // bindPopup: sæt en popup på markøren
          markør.bindPopup(this.lagPopupHTML(lok), {
            maxWidth: 280,
            className: "mda-popup",
          });

          // når man klikker på markøren, vælges lokationen
          markør.on("click", () => this.vælgLokation(lok.id));

          // gem markøren i vores opslag
          this.markørMap[lok.id] = markør;
        });

        // tilpas kortets visning så alle markører kan ses
        if (this.lokationer.length > 1) {
          // L.latLngBounds: beregn den mindste firkant der indeholder alle punkter
          const bounds = window.L.latLngBounds(
            this.lokationer.map((l) => [l.lat, l.lng]),
          );
          // fitBounds: zoom og centrer til den firkant
          this.kortInstans.fitBounds(bounds.pad(0.25), { animate: false });
        } else if (this.lokationer.length === 1) {
          // setView: centrer på den ene lokation med zoom 12
          this.kortInstans.setView(
            [this.lokationer[0].lat, this.lokationer[0].lng],
            12,
          );
        }
      },

      // Alpine.js + Leaflet: vælgLokation – det der sker når brugeren klikker på en knap eller markør
      vælgLokation(id) {
        this.aktivId = id; // Alpine opdaterer alt der afhænger af aktivId

        // skift ikon på alle markører (aktiv/inaktiv)
        Object.entries(this.markørMap).forEach(([markørId, markør]) => {
          markør.setIcon(this.lagIkon(markørId === id));
        });

        const lok = this.aktivLokation;
        if (lok && this.kortInstans) {
          // flyTo: flyv hen til lokationen med en blød animation
          this.kortInstans.flyTo([lok.lat, lok.lng], 13, {
            animate: true,
            duration: 0.8,
          });
          // openPopup: åbn popuppen på den valgte markør
          this.markørMap[id]?.openPopup();
        }

        // på mobil/tablet (under 1024px): scroll ned så man kan se detaljerne
        if (window.innerWidth < 1024) {
          this.$nextTick(() => {
            const panel = this.$el.querySelector("[x-show]");
            if (panel) {
              panel.scrollIntoView({ behavior: "smooth", block: "start" });
            }
          });
        }
      },

      // Leaflet: lagIkon – byg vores eget markør-ikon (dråbeform)
      lagIkon(erAktiv) {
        // L.divIcon: et ikon lavet af HTML og CSS i stedet for et billede
        return window.L.divIcon({
          className: "mda-pin-wrapper",
          // størrelsen på ikonet
          iconSize: [36, 48],
          // punktet på ikonet der præcist peger på kortet
          iconAnchor: [17, 46],
          html: `
            <div class="mda-pin ${erAktiv ? "mda-pin--aktiv" : ""}">
              <div class="mda-pin__body">
                <div class="mda-pin__center"></div>
              </div>
            </div>
          `,
        });
      },

      // Leaflet: lagPopupHTML – byg HTML'en til den popup der vises når man klikker på en markør
      // Vi skriver styles direkte, fordi popuppen bliver lagt udenfor vores komponent
      lagPopupHTML(lok) {
        // lav en streng med links til alle trænere
        const trænereHTML = lok.traenere
          .map(
            (t) => `
              <a href="${t.href}"
                style="display:block; font-family:var(--font-body); font-weight:600;
                       font-size:12px; color:var(--link-text); margin-top:4px;
                       text-decoration:none;"
                onmouseover="this.style.textDecoration='underline'"
                onmouseout="this.style.textDecoration='none'">
                ↗ ${t.navn}
              </a>`,
          )
          .join("");

        return `
          <div style="font-family:var(--font-body); min-width:210px;">
            <p style="margin:0 0 2px; font-size:10px; letter-spacing:.08em;
                      text-transform:uppercase; color:var(--text-label);">
              Lokation
            </p>
            <p style="margin:0 0 3px; font-family:var(--font-heading);
                      font-size:16px; font-weight:600; color:var(--text-primary);">
              ${lok.label}
            </p>
            <p style="margin:0 0 10px; font-size:12px; color:var(--text-secondary);">
              ${lok.adresse}
            </p>
            ${
              trænereHTML
                ? `<p style="margin:6px 0 3px; font-size:10px; text-transform:uppercase;
                            letter-spacing:.06em; color:var(--text-label);">Instruktører</p>
                 ${trænereHTML}`
                : ""
            }
          </div>
        `;
      },
    };
  }
</script>

<!-- Global CSS (is:global) – fordi Leaflet lægger popups og markør-wrapper udenfor komponenten -->
<style is:global>
  /* Leaflet: popup-boksens udseende */
  .mda-popup .leaflet-popup-content-wrapper {
    border-radius: var(--primitive-radius-lg);
    border: 1px solid var(--neutral-200);
    padding: 0;
    overflow: hidden;
  }
  .mda-popup .leaflet-popup-content {
    margin: var(--primitive-space-12) var(--primitive-space-16);
  }
  .mda-popup .leaflet-popup-tip-container {
    margin-top: -1px;
  }
  .mda-popup .leaflet-popup-close-button {
    color: var(--neutral-400);
    font-size: var(--text-size-15);
    padding: var(--primitive-space-4) var(--primitive-space-8);
  }

  /* Leaflet: fjern standard-udseendet på wrapperen omkring vores custom ikon */
  .mda-pin-wrapper {
    background: transparent !important;
    border: none !important;
  }

  /* markørens grundform */
  .mda-pin {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--primitive-space-40);
    height: var(--primitive-space-40);
    /* drej og skaler fra spidsen */
    transform-origin: 50% 100%;
    transition: transform 0.2s ease;
  }
  /* aktiv markør er 8% større */
  .mda-pin--aktiv {
    transform: scale(1.08);
  }

  /* dråbeformens krop */
  .mda-pin__body {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--primitive-space-40);
    height: var(--primitive-space-40);
    /* tre runde hjørner, ét skarpt */
    border-radius: 50% 50% 50% 0;
    /* drej så det skarpe hjørne peger nedad */
    transform: rotate(-45deg);
    background: var(--accent-400);
    border: 2px solid var(--neutral-100);
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  /* mørkere farve når aktiv */
  .mda-pin--aktiv .mda-pin__body {
    background: var(--accent-500);
  }

  /* den hvide prik i midten */
  .mda-pin__center {
    width: var(--primitive-space-12);
    height: var(--primitive-space-12);
    border-radius: var(--primitive-radius-full);
    background: var(--neutral-0);
    /* ret prikken op igen */
    transform: rotate(45deg);
    transition: background-color 0.2s ease;
  }
  .mda-pin--aktiv .mda-pin__center {
    background: var(--neutral-100);
  }
</style>
