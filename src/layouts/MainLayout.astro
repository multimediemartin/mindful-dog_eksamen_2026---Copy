---
import "../styles/tailwind.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title } = Astro.props;
---

<html lang="da">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <!-- Henter det gemte tema og sætter det på siden, før siden vises. -->
    <script is:inline>
      // Læser det sidst valgte tema fra browserens lager.
      const savedTheme = localStorage.getItem("theme");
      // Bruger kun dark hvis det faktisk er vlagt og gemt, ellers kkører den bare standart tokens og variabler
      const theme = savedTheme === "dark" ? "dark" : "standard";
      // Sætter data-theme på herle siden.
      document.documentElement.dataset.theme = theme;
      // Fortæller browseren om siden skal være som lys eller mørk.
      document.documentElement.style.colorScheme =
        theme === "dark" ? "dark" : "light";
    </script>
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Geologica:wght@100..900&family=Manrope:wght@200..800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="sticky top-0 z-10">
      <Header />
    </header>

    <main class="bg-(--neutral-100)">
      <slot />
    </main>

    <footer class="">
      <Footer />
    </footer>
  </body>
</html>
